{
  "rules": {
    "parties": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || (!newData.exists() && !data.child('members').exists()))",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)",
        "map": {
          ".write": "auth != null && root.child('parties').child($code).child('members').child(auth.uid).exists()"
        },
        "runId": {
          ".write": "auth != null && root.child('parties').child($code).child('members').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "duel": {
          ".write": "auth != null && root.child('parties').child($code).child('members').child(auth.uid).exists()"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('parties').child($code).child('members').child(auth.uid).exists())"
          }
        }
      }
    }
  }
}
